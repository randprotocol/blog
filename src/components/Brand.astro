---
// The Rand brand as randprotocol.org draws it (its src/components/Brand.astro):
// the entropy mark, a 4x4 Bayer tile with one hot pixel in the accent colour,
// beside the pixel-face wordmark. The visible word is `rand`; `section` names
// this part of the site next to it; the accessible name is the blog's title.
import { SITE } from "@/config";

interface Props {
  href?: string;
  section?: string;
  class?: string;
}

const { href, section, class: cls = "" } = Astro.props;

// The cells a level of ~10/16 lights, and the one hot cell.
const on = [0, 2, 5, 7, 8, 10, 13, 15, 1, 11];
const hot = 11;
const Tag = href ? "a" : "div";
---

<Tag href={href} class:list={["brand", cls]}>
  <svg class="mark" viewBox="0 0 23 23" aria-hidden="true" focusable="false">
    {
      on.map(i => (
        <rect
          class={i === hot ? "hot" : undefined}
          x={(i % 4) * 6}
          y={Math.floor(i / 4) * 6}
          width="5"
          height="5"
        />
      ))
    }
  </svg>
  <span class="name" aria-hidden="true">rand</span>
  {
    section && (
      <span class="section" aria-hidden="true">
        {section}
      </span>
    )
  }
  <span class="sr-only">{SITE.title}</span>
</Tag>
