---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { withTrailingSlash } from "@/utils/withBase";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

const { page } = Astro.props;

// Astro's paginate() already puts the base in these; they only lack the
// trailing slash the built pages are served at.
const prevUrl = page.url.prev ? withTrailingSlash(page.url.prev) : undefined;
const nextUrl = page.url.next ? withTrailingSlash(page.url.next) : undefined;
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!prevUrl}
        href={prevUrl}
        class:list={["me-4 select-none", { "opacity-50": !prevUrl }]}
        aria-label="Goto Previous Page"
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        Prev
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!nextUrl}
        href={nextUrl}
        class:list={["ms-4 select-none", { "opacity-50": !nextUrl }]}
        aria-label="Goto Next Page"
      >
        Next
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
